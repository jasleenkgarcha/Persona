# Copy this file to .env and fill it in. NEVER commit .env.
# Share real values by DM or a password manager, not in git.

# --- Photon (Ian) ---
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_AGENT_USER_ID=
# Your personal number in E.164 format, e.g. +15551234567
OWNER_PHONE=

# --- ElevenLabs (Ian) ---
ELEVENLABS_WEBHOOK_SECRET=
# Random string. ElevenLabs sends it in the X-Tool-Secret header.
TOOL_SHARED_SECRET=

# --- Chalk router and scorer (Naiessha) ---
CHALK_ROUTER_URL=
CHALK_API_KEY=
CHALK_ENV_ID=
SCORER_MODEL=

# --- Supabase (Pablo) ---
SUPABASE_URL=
# Backend only. Never put this in the dashboard.
SUPABASE_SERVICE_KEY=
# Read-only key. The dashboard uses the NEXT_PUBLIC_* copies in dashboard/.env.local
SUPABASE_ANON_KEY=

# --- Stub switches (delete once the real code lands) ---
# The stub check_caller returns this. Use "pass" only for the transfer test.
STUB_DECISION=block
# Where the stub webhook saves the last raw payload (gitignored)
RAW_WEBHOOK_PATH=samples/last_webhook_raw.json
